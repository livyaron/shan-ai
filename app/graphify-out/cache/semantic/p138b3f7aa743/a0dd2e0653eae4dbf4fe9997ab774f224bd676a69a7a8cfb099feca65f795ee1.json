{"nodes": [{"id": "templates__war_room_actions", "label": "_war_room_actions.html (shared war-room write actions)", "file_type": "code", "source_file": "templates/_war_room_actions.html", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every layout posts to the same endpoints with the same element-id conventions (note-<id>, closenote-<id>, quad-<id>, own-<id>, due-<id>), so behaviour lives once and new layouts inherit it."}, {"id": "templates__war_room_actions_post", "label": "post(url, data)", "file_type": "code", "source_file": "templates/_war_room_actions.html", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates__war_room_actions_wrreload", "label": "wrReload(id)", "file_type": "code", "source_file": "templates/_war_room_actions.html", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saves window + inner scroll positions and touched mission id in sessionStorage (wr_pos_v1) so a reload returns to the same spot (user 2026-10-21); same page and under a minute only."}, {"id": "templates__war_room_actions_wrrestore", "label": "wrRestore() scroll/flash restore", "file_type": "code", "source_file": "templates/_war_room_actions.html", "source_location": "L89", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates__war_room_actions_wrownerfilter", "label": "wrOwnerFilter(inp)", "file_type": "code", "source_file": "templates/_war_room_actions.html", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates__war_room_actions_act", "label": "act(id, action)", "file_type": "code", "source_file": "templates/_war_room_actions.html", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates__war_room_