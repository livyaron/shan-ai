# Database
POSTGRES_PASSWORD=your_db_password_here
DATABASE_URL=postgresql+asyncpg://shan_user:your_db_password_here@localhost:5432/shan_ai

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM providers. GROQ is primary; GOOGLE_AI_API_KEY is the fallback llm_router
# switches to when Groq fails or is rate-limited — without it there is no backup.
# Check both with /dashboard/llm-health?probe=1
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_studio_key_here

# FastAPI
DEBUG=True
JWT_SECRET_KEY=change-me-random-hex
